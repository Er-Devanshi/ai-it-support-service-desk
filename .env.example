# ============================================================
# ServiceDesk-AI — Environment Variables Example
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# ----- Application -----
APP_ENV=development          # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# In development, the frontend is usually served from localhost or file://.
# Example: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
CORS_ORIGINS=*

# ----- LLM API (Phase 2) -----
# Uncomment and fill in when LLM integration is implemented.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_TOKENS=1024

# ----- Vector Database (Phase 2) -----
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Database (Phase 3) -----
# DATABASE_URL=sqlite:///./servicedesk.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/servicedesk

# ----- Authentication (Phase 3) -----
# JWT_SECRET_KEY=replace-with-a-long-random-secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=60

# ----- Email / Notifications (Phase 4) -----
# SMTP_HOST=smtp.company.internal
# SMTP_PORT=587
# SMTP_USER=servicedesk@company.com
# SMTP_PASSWORD=
