# ============================================================
# ServiceDesk-AI — Environment Variables Example
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# ----- Application -----
APP_ENV=development          # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# Use * for local development or specify allowed frontend addresses.
CORS_ORIGINS=*

# ----- LLM Provider Configuration (CRITICAL) -----
# Select active provider: 'gemini' | 'mock' | 'openai' | 'ollama'
# If set to 'gemini' without an API key, the system falls back safely to 'mock' mode.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Force offline mock / demonstration mode regardless of API keys (true | false)
DEMO_MODE=false

# ----- Google Gemini API Configuration -----
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ----- OpenAI API Configuration (Optional future provider) -----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ----- Local Ollama Configuration (Optional local models) -----
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ----- Database -----
# SQLite is used by default. For PostgreSQL, supply a postgresql:// connection URI.
DATABASE_URL=sqlite:///./backend/servicedesk.db

# ----- Authentication & JWT Security -----
# Provide a strong random secret key in production.
JWT_SECRET_KEY=servicedesk-ai-insecure-dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=120

# ----- RAG & Knowledge Base Configuration -----
RAG_ENABLED=true
KNOWLEDGE_BASE_DIR=./data/knowledge_base
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=servicedesk_knowledge_base
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0.35
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
