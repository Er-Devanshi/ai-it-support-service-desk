# ============================================================
# ServiceDesk-AI — Environment Variables Example
#
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# ----- Application -----
APP_ENV=development          # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ----- CORS -----
# Comma-separated list of allowed frontend origins.
# Use * for local development or specify allowed frontend addresses.
CORS_ORIGINS=*

# ----- In-house NLP Engine Configuration (NO external APIs) -----
# ServiceDesk-AI uses a custom Python NLP engine:
# - Multinomial Naive Bayes classifier (trained on labeled tickets)
# - BM25 retrieval (no embeddings, no vector DB)
# - No external LLM calls (Gemini, OpenAI, Ollama, etc.)
# - No pretrained models (transformers, sentence-transformers, etc.)

# Classifier confidence threshold [0.0 - 1.0]
# If classifier confidence is below this, issue is marked for escalation
CLASSIFIER_CONFIDENCE_THRESHOLD=0.5

# Database
# SQLite is used by default. For PostgreSQL, supply a postgresql:// connection URI.
DATABASE_URL=sqlite:///./backend/servicedesk.db

# ----- Authentication & JWT Security -----
# Provide a strong random secret key in production.
JWT_SECRET_KEY=servicedesk-ai-insecure-dev-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=120

# ----- RAG & Knowledge Base Configuration -----
RAG_ENABLED=true
KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_TOP_K=3
RAG_RELEVANCE_THRESHOLD=0.35
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
