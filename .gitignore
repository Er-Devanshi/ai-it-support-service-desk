# ============================================================
# ServiceDesk-AI — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.pytype/

# ----- Environment & secrets -----
.env
*.env
secrets.json
credentials.json

# ----- IDEs -----
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
logs/

# ----- Node (if a JS build tool is added later) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Vector database files (Phase 2+) -----
chroma_db/
faiss_index/
*.faiss
*.pkl

# ----- Local database files (Phase 3+) -----
*.sqlite
*.db

# ----- Jupyter notebooks checkpoints -----
.ipynb_checkpoints/

# ----- Auto-generated project structure files -----
project_structure.txt

# ----- Kiro IDE files -----
.kiro/
